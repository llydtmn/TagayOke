# Copy this file to .env and fill in your values
# XAMPP MySQL defaults: host=localhost port=3306 user=root password=(empty)

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=calbayog_farmers

JWT_SECRET=calbayog_secret_key_change_in_production
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
